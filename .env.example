# Copy to .env.local and fill in what you have. Every value is optional for
# `npm run dev` / `npm run build` — missing values just disable that feature
# and the UI shows a "connect X" state instead of breaking.

# --- Supabase (auth, database, storage) ---------------------------------
# Project settings -> API. Required for sign-in, properties, photos, reports.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project settings -> API keys -> secret (or legacy admin) key. Server-only. Required for account
# deletion and the Stripe webhook's write path. Never expose to the client.
SUPABASE_SECRET_KEY=

# --- Stripe (optional — one-time $17 Shield unlock) ----------------------
# If unset, the app shows a "DEV: Unlock free" button everywhere the paywall
# appears so the full paid flow can still be tested without Stripe.
STRIPE_SECRET_KEY=
# From `stripe listen --print-secret` locally, or the webhook endpoint's
# signing secret in the Stripe dashboard in production.
STRIPE_WEBHOOK_SECRET=

# --- App URL --------------------------------------------------------------
# Used for Stripe success/cancel redirect URLs and absolute metadata URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Resend (optional — emailing the report to a landlord) ---------------
# If unset, "Send to landlord" opens a prefilled mailto: draft with a PDF
# download link instead of sending automatically.
RESEND_API_KEY=
